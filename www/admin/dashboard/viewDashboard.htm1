<script>	
$(document).ready(function() {		  
	<?=$datathang?>
	var chart_plot_02_settings = {
		grid: {
			show: true,
			aboveData: true,
			color: "#3f3f3f",			
			axisMargin: 0,
			borderWidth: 0,
			borderColor: null,			
			clickable: true,
			hoverable: true,
			autoHighlight: true,
			mouseActiveRadius: 100
		},
		series: {
			lines: {
				show: true,
				fill: true,
				lineWidth: 2,
				steps: false
			},
			points: {
				show: true,
				radius: 4.5,
				symbol: "circle",
				lineWidth: 3.0
			}
		},
		
		colors: ['#96CA59', '#3F97EB', '#72c380', '#6f7a8a', '#f7cb38', '#5a8022', '#2c7282'],
		shadowSize: 0,
		
		yaxis: {
			min: 0
		},
		xaxis: {			
			tickSize: [1]
		}
	};	

	if ($("#chart_plot_02").length){
		console.log('Plot2');
		
		$.plot( $("#chart_plot_02"), 
		[{ 
			label: "", 
			data: chart_plot_02_data, 			
			lines: { 
				fillColor: "rgba(150, 202, 89, 0.12)" 
			}, 
			points: { 
				fillColor: "#fff" } 
		}], chart_plot_02_settings);
		
	}
	
	var ctxthang = document.getElementById("mybarChartthang");
	ctxthang.height = 170;
	var mybarChartthang = new Chart(ctxthang, {
	type: 'bar',
	data: {
	  <?=$labels?>,
	  datasets: [{
		label: 'Số tin bài',
		backgroundColor: "#26B99A",
		<?=$data?>
	  }]
	},

	options: {
	  legend: {
				display: false
			},	
	  scales: {
		yAxes: [{
		  ticks: {
			beginAtZero: true
		  }
		}]
	  }
	}
	});
		
})  
</script>